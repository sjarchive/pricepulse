# Optional: Pre-configure admin credentials and a persistent session signing secret
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Optional: Telegram Bot token from @BotFather for sending live Telegram alerts
TELEGRAM_BOT_TOKEN=

# Optional: Resend API key for live Email alerts (free tier: 100 emails/day)
RESEND_API_KEY=
RESEND_FROM=

# Optional: Web Push VAPID keys (P-256 base64url) for background Chrome/browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@pricepulse.app
